{
  "name": "reta-final-enem",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/prepare-commercial-content.mjs && vite build",
    "build:sales": "node scripts/prepare-commercial-content.mjs && vite build --mode commercial --base=./",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "build:pages": "node scripts/prepare-commercial-content.mjs && vite build --base=./ && node scripts/build-pages.mjs",
    "start": "node server/app.js",
    "dev:server": "node --watch server/app.js",
    "test:e2e": "playwright test",
    "backup": "node server/backup.js",
    "test:cloud": "playwright test --config playwright.cloud.config.js",
    "test:sql": "bash tests/sql/run.sh",
    "validate:questions": "node scripts/validate-questions.mjs",
    "test:pages": "playwright test --config playwright.pages.config.js",
    "verify:originals": "python scripts/verify-official-originals.py",
    "prebuild:pages": "npm run validate:release",
    "validate:release": "node scripts/validate-questions.mjs --require-target",
    "prebuild": "npm run validate:release",
    "prebuild:sales": "npm run validate:release"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "vite": "^7.2.2"
  },
  "engines": {
    "node": ">=24.10.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0"
  }
}
